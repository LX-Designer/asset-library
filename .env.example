# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local — it is listed in .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

